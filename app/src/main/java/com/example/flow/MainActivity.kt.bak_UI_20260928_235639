fun cargarSuperMaestro(
    context: android.content.Context
): JSONArray {

    val json =
        context.assets
            .open("supermaestro_flow.json")
            .bufferedReader()
            .use { it.readText() }

    val raiz =
        JSONObject(json)

    return raiz.getJSONArray("SUPERMAESTRO")
}

