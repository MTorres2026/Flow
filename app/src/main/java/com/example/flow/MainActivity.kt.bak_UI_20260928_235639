private fun leerCampoIdNumericoComoTexto(
    objeto: JSONObject,
    clave: String
): String {

    val valor =
        objeto.opt(clave)
            ?: return ""

    return when (valor) {

        is Number ->
            BigDecimal(
                valor.toString()
            )
                .toPlainString()
                .removeSuffix(".0")

        else ->
            valor.toString().trim()
    }
}

private fun crearSugerenciaVisualNoPropuesta(
    producto: ProductoFlow,
    propuesta: PropuestaPedido?
): OrderSuggestion {

    return OrderSuggestion(
        idVista = producto.idVista,
        producto = producto.producto,
        idErp = producto.idErp,
        umErp = producto.umErp,
        idConway = producto.idConway,
        denominacionLargaConway = producto.denominacionLargaConway,
        presentacion = producto.presentacion,
        unidadesPorCajaPack = producto.unidadesPorCajaPack,
        unidadPedidoFlow = producto.unidadPedidoFlow,
        estado = propuesta?.estado ?: "SIN ANALISIS",
        fuente = producto.fuente,
        notaRegla = producto.notaRegla,
        debeRevisarse = propuesta?.necesitaRevision ?: false,
        cantidadSugerida = 0.0,
        nivelEvidencia =
            propuesta?.nivelEvidencia ?: "DESCONOCIDO",
        numeroEpisodios = 0,
        consumoMedio = null,
        stockActualRegistrado = producto.stockFinal,
        motivo =
            propuesta?.motivo
                ?: "No existe una propuesta automática activa para este producto."
    )
}

private fun claveVarianteFamiliaRevision(
    linea: LineaPedidoFamiliaFlow
): String {

    return when {

        linea.idErp.isNotBlank() ->
            "F|${linea.idVistaFamilia}|ERP|${linea.idErp}|UM|${linea.umErp}"

        linea.idConway.isNotBlank() &&
                linea.idConway != "-" &&
                linea.idConway != "—" ->
            "F|${linea.idVistaFamilia}|CONWAY|${linea.idConway}"

        else ->
            "F|${linea.idVistaFamilia}|PRODUCTO|${linea.producto.trim().uppercase()}"
    }
}

fun formatearCantidadRevision(
    cantidad: Double?
): String {

    if (
        cantidad == null
    ) {
        return ""
    }

    return BigDecimal
        .valueOf(cantidad)
        .stripTrailingZeros()
        .toPlainString()
}

fun extraerFechaInicioInforme(
    texto: String
): String {

    val patron =
        Regex(
            """From:\s+[^,]+,\s+(\d{2}/\d{2}/\d{4})\s+\d{2}:\d{2}"""
        )

    val coincidencia =
        patron.find(texto)
            ?: throw IllegalStateException(
                "No se pudo encontrar la fecha de inicio del informe."
            )

    return coincidencia.groupValues[1]
}